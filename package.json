{
  "name": "algoverse",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*",
    "cli"
  ],
  "scripts": {
    "dev": "next dev",
    "dev:clean": "node scripts/clean-next.mjs && next dev",
    "clean": "node scripts/clean-next.mjs",
    "build": "next build",
